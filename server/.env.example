# Private feed consumed by /opt/bitrix-tools feedback digest. Keep it outside
# public nginx paths; the real file is created atomically with mode 0640.
INTERNAL_REVIEWS_FEED_PATH=/opt/shared/yclients-reviews-feed.json

# Existing private snapshot of yClients records. The reviews feed reads it
# locally for course/date context; it never exposes the source file or client IDs.
YCLIENTS_RECORDS_SNAPSHOT_PATH=/opt/shared/yclients-records-snapshot.json

# The comments snapshot is refreshed twice an hour after the 2026-07-28
# aggregate check found no qualifying review webhook events in production.
REVIEWS_SNAPSHOT_CRON=5,35 * * * *
